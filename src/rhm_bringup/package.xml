  <description>Native Ubuntu ROS 2 lifecycle monitor bringup (no simulated or real motion).</description>
  <maintainer email="maintainer@example.invalid">RHM contributors</maintainer>
  <license>MIT</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
